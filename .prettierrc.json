{
  "tabWidth": 4,
  "arrowParens": "avoid",
  "trailingComma": "none",
  "printWidth": 80,
  "endOfLine": "lf",
  "semi": false,
  "overrides": [
    {
      "files": "*.{json,yml,yaml}",
      "options": {
        "tabWidth": 2,
        "proseWrap": "always"
      }
    },
    {
      "files": ["messages.ts", "questions.ts"],
      "options": {
        "printWidth": 140
      }
    }
  ],
  "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-packagejson", "prettier-plugin-jsdoc"]
}
